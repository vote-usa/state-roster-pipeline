{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vote-usa.org/schema/roster/county_ballots.schema.json",
  "title": "county_ballots.json",
  "description": "One object per county per election where the source publishes a per-county ballot.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [ "state", "county", "ocd_division_id", "election_date", "election_type", "candidates", "measures", "source_url" ],
    "properties": {
      "state": { "$ref": "common.schema.json#/$defs/state" },
      "county": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "ocd_division_id": { "$ref": "common.schema.json#/$defs/nullableOcdDivisionId" },
      "election_date": { "$ref": "common.schema.json#/$defs/date" },
      "election_type": { "$ref": "common.schema.json#/$defs/electionType" },
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "office", "district", "ocd_division_id", "candidate_name", "party", "source_office_id", "source_office_type", "local_jurisdiction" ],
          "properties": {
            "office": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "district": { "$ref": "common.schema.json#/$defs/nullableString" },
            "ocd_division_id": { "$ref": "common.schema.json#/$defs/nullableOcdDivisionId" },
            "candidate_name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "party": { "$ref": "common.schema.json#/$defs/nullableString" },
            "source_office_id": { "$ref": "common.schema.json#/$defs/nullableString" },
            "source_office_type": { "$ref": "common.schema.json#/$defs/nullableString" },
            "local_jurisdiction": { "$ref": "common.schema.json#/$defs/nullableString" }
          }
        }
      },
      "measures": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "measure_id", "title", "summary", "jurisdiction", "ocd_division_id" ],
          "properties": {
            "measure_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "summary": { "$ref": "common.schema.json#/$defs/nullableString" },
            "jurisdiction": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "ocd_division_id": { "$ref": "common.schema.json#/$defs/nullableOcdDivisionId" }
          }
        }
      },
      "source_url": { "$ref": "common.schema.json#/$defs/url" }
    }
  }
}
